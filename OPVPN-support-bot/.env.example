# Token from @BotFather for the separate technical-support bot
SUPPORT_BOT_TOKEN=

# Telegram user IDs authorized to use /tickets, /reply and /close
SUPPORT_ADMIN_IDS=

# DeepSeek API key and model for the AI dispatcher
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional: enables direct read-only GET checks against YooKassa.
# Keep these server-side; they are never sent to DeepSeek.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional: path to the main OPVPN SQLite database. When empty, account lookups stay disabled.
OPVPN_DB_PATH=

# Optional: scoped token for the future read-only status endpoint in the main bot.
# The main 3x-ui API token does not belong here; it has full administrator access.
OPVPN_PANEL_STATUS_API_URL=
OPVPN_PANEL_STATUS_API_TOKEN=

# Relative paths are resolved from this project directory
SUPPORT_DB_PATH=data/support.sqlite3
SUPPORT_LOG_LEVEL=INFO
