# Образец systemd-юнита (установщик install.sh создаёт такой же автоматически).
# 1) положите файл в /etc/systemd/system/opvpnbot.service
# 2) поправьте пути, если ставили не в /srv/opvpnbot
# 3) systemctl daemon-reload && systemctl enable --now opvpnbot
[Unit]
Description=OPVPN (Telegram bot for VPN subscriptions)
After=network-online.target
Wants=network-online.target
# Щит от crash-loop: не больше 12 запусков за 10 минут. Провал при старте из-за
# сети (например, недоступен api.telegram.org) успевает восстановиться сам, а
# вечный цикл падений не заспамливает лог — служба остаётся в failed.
StartLimitIntervalSec=600
StartLimitBurst=12

[Service]
Type=simple
User=opvpn
Group=opvpn
WorkingDirectory=/srv/opvpnbot
EnvironmentFile=/srv/opvpnbot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/opvpnbot/.venv/bin/python /srv/opvpnbot/bot.py
Restart=always
RestartSec=5
# Код 2 — ошибка конфигурации (bot.py: validate() → SystemExit(2)). Перезапуск
# тут бессмыслен: .env сам не починится, а рестарты каждые 5 с только топят лог.
# Исправили .env → systemctl restart opvpnbot.
RestartPreventExitStatus=2
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opvpnbot
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
