# ============================================================================
#  OPVPN — образец конфигурации.
#  Скопируйте в .env  →  cp .env.example .env  и заполните значения.
#  Файл .env в git не попадает (см. .gitignore).
# ============================================================================

# --- Telegram (обязательно) -------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram ID администраторов (через запятую). Узнать: @userinfobot
ADMIN_IDS=123456789
# Название сервиса в приветствии
BOT_NAME=OPVPN
# Поддержка (без @) — показывается в кнопках
SUPPORT_USERNAME=support
# Ссылка на новостной канал (необязательно)
NEWS_CHANNEL_URL=
# Обязательная подписка на каналы для пользователей, например: @channel1,@channel2
# Бот должен быть администратором этих каналов, иначе проверка не сработает
REQUIRED_CHANNELS=

# --- Тарифы, продажи --------------------------------------------------------
CURRENCY=₽
# Пробный период
TRIAL_ENABLED=false
TRIAL_DAYS=3
TRIAL_DEVICES=1
TRIAL_TRAFFIC_GB=10
# Способы оплаты: yookassa
PAYMENT_METHODS=yookassa

# Прокси для ИСХОДЯЩИХ запросов к платёжному API ЮKassa. Нужен, когда VPS
# стоит за рубежом и не достаёт до российских платёжных сервисов, а Telegram при
# этом работает. Формат: http://user:pass@host:port (схема только http/https;
# SOCKS потребует доп. библиотеку aiohttp-socks). Пусто — ходим напрямую.
PAYMENTS_PROXY=

# --- ЮKassa (карты РФ, СБП) -------------------------------------------------
# Магазин и секретный ключ: https://yookassa.ru/my/i/integration/api-keys
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда возвращать пользователя после оплаты (можно ссылку на бота)
YOOKASSA_RETURN_URL=https://t.me
# Тестовый магазин ЮKassa (ключи test_*)
YOOKASSA_TEST=false

# --- Вебхуки ЮKassa (рекомендуется) -----------------------------------------
# Включите, если у бота есть публичный HTTPS-адрес (домен + nginx/caddy).
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/yookassa/webhook
# ВАЖНО: этот же адрес нужно указать в кабинете ЮKassa → Интеграция → HTTP-уведомления
WEBHOOK_PUBLIC_URL=https://bot.example.com/yookassa/webhook
# Фильтр по IP ЮKassa включён всегда. Если перед ботом стоит ваш reverse-proxy
# (nginx/caddy), ставьте true — иначе реальный IP ЮKassa не увидеть (remote будет
# адресом прокси) и все уведомления будут отклоняться с 403. При этом обязательно
# передавайте X-Forwarded-For (см. docs/SETUP-PAYMENTS.md). Без прокси оставьте false.
WEBHOOK_TRUST_PROXY=false

# --- Healthcheck для внешнего мониторинга (uptime) --------------------------
# Бот поднимает HTTP-эндпоинт GET /healthz (проверяет БД) — независимо от
# вебхуков. Укажите этот адрес в мониторе (healthchecks.io, UptimeRobot,
# Better Stack), чтобы получать алерт, если бот упал/завис.
# Локально/systemd: 127.0.0.1 и проксирование через nginx.
# В Docker: HEALTH_HOST=0.0.0.0 и пробросьте порт (ports: "8081:8081").
# ВНИМАНИЕ: HEALTH_PORT не должен совпадать с WEBHOOK_PORT.
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8081

# ============================================================================
#  ВЫДАЧА КЛЮЧЕЙ: VPN_PANEL = xui
# ============================================================================

# --- Панель 3x-ui -----------------------------------------------------------
# Клиент создаётся и продлевается через API панели 3x-ui.
VPN_PANEL=xui
# XUI_URL — адрес панели вместе с путём, если он изменён
XUI_URL=http://127.0.0.1:2053
XUI_USERNAME=admin
XUI_PASSWORD=
# Либо API-токен (Настройки → Безопасность → API Token) — предпочтительнее
XUI_API_TOKEN=
# ID inbound'ов, к которым добавлять клиента (посмотреть: /panel/inbounds/list или в веб-панели).
# Несколько ID через запятую — тогда панель соберёт их в одну подписку XUI_SUB_BASE/{subId},
# т.е. в один ключ попадут разные шифрования/транспорты. Нужны актуальные сборки 3x-ui.
XUI_INBOUND_IDS=1
# Устаревшая одиночная переменная; используется, только если XUI_INBOUND_IDS пуст
# XUI_INBOUND_ID=1
# Публичный адрес сервера для ссылок (если отличается от адреса панели), например vpn.example.com
XUI_PUBLIC_HOST=
# База подписочного сервера 3x-ui (Settings → Subscription), обычно порт 2096, например
# https://sub.example.com/sub. Если задана — бот отдаёт пользователю ТОЛЬКО эту подписку
# (XUI_SUB_BASE/{subId}), куда панель кладёт все inbound'ы клиента. Обязательна для XUI_INBOUND_IDS.
XUI_SUB_BASE=

# Проверка TLS-сертификата панели. По умолчанию включена (true) — рекомендуем
# оставить. Для панели на self-signed сертификате лучше указать свой CA-файл
# (XUI_CA_FILE), чем отключать проверку. XUI_VERIFY_SSL=false ПОЛНОСТЬЮ
# отключает проверку сертификата (риск MITM).
XUI_VERIFY_SSL=true
# Путь к PEM-файлу CA/сертификата вашей панели (если сертификат самоподписанный).
XUI_CA_FILE=

# --- Привязка существующих клиентов панели (только VPN_PANEL=xui) -----------
# Включает кнопку «🔗 QR для клиента» в админке: админ вводит subId/email
# клиента из панели и получает ссылку/QR вида https://t.me/<bot>?start=claim_<token>.
# Клиент открывает ссылку — бот привязывает его Telegram и он продлевает сам.
CLAIM_ENABLED=false
# Секрет для подписи ссылок привязки (любая случайная строка). Обязателен при CLAIM_ENABLED=true.
CLAIM_SECRET=
# Срок жизни ссылки привязки, часов (по умолчанию 168 = 7 дней). Минимум 1.
CLAIM_TTL_HOURS=168

# --- Служебное ---------------------------------------------------------------
DB_PATH=data/opvpnbot.sqlite3
LOG_LEVEL=INFO
LOG_FILE=data/bot.log
# Отключать клиента в панели по истечении подписки
AUTO_DISABLE_EXPIRED=true
# За сколько дней предупреждать об окончании подписки
NOTIFY_DAYS_BEFORE=3,1
# Через сколько часов отменять неоплаченные заказы
ORDERS_TTL_HOURS=48
# Анти-абьюз: максимум неоплаченных заказов на пользователя (0 — без лимита)
MAX_PENDING_ORDERS=5
# Автоматические бэкапы БД в data/backups/ (с ротацией). 0 = выключить.
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=48
# Анти-спам: минимальный интервал между действиями пользователя, сек
THROTTLING_RATE=0.6
# Свои тексты (необязательно)
TERMS_TEXT=
PRIVACY_TEXT=
